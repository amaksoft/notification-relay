# Firebase
.firebase/
*-debug.log
*.local.js

# Env / secrets — CLI service-account key (see docs/OPERATIONS.md for
# regeneration steps; a gitignored file the CLI needs is a documented
# setup step, never a silent trap)
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
.secret.local

# Node / web build
node_modules/
npm-debug.log*
web/dist/

# Python (Cloud Functions + CLI)
functions/venv/
**/__pycache__/
*.pyc
.venv/
*.egg-info/

# Android
android/**/build/
android/.gradle/
android/local.properties
android/**/*.apk
android/**/*.aab
# Firebase config — regenerate via android/scripts/fetch_google_services.sh
# (see docs/OPERATIONS.md); not a real secret (it's baked into every built
# APK regardless), gitignored per user preference rather than for security.
android/app/google-services.json

# OS / editor
.DS_Store
.vscode/
