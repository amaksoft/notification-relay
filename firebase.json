{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python313",
      "predeploy": [
        "python3 -m venv functions/venv",
        "functions/venv/bin/pip install -q -r functions/requirements.txt"
      ],
      "ignore": [
        "venv",
        ".venv",
        "__pycache__",
        ".git",
        "*.pyc",
        "*.pyo",
        "tests"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/webhooks",
        "function": { "functionId": "webhooks_api", "region": "us-central1" }
      },
      {
        "source": "/api/webhooks/**",
        "function": { "functionId": "webhooks_api", "region": "us-central1" }
      },
      {
        "source": "/api/test-receiver",
        "function": { "functionId": "test_receiver", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
